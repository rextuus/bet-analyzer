{% extends 'base.html.twig' %}

{% block title %}Placements · {{ simulator.identifier }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div class="mw-100">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_tipico_simulator_list') }}">Simulators</a></li>
                    <li class="breadcrumb-item"><a
                                href="{{ path('app_tipico_simulation_detail', {simulator: simulator.id}) }}">#{{ simulator.id }}</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Placements</li>
                </ol>
            </nav>
            <h1 class="text-break">{{ simulator.identifier }}</h1>
            <p class="page-subtitle">{{ placements|length }} placements</p>
        </div>
    </div>
    <div class="table-container table-responsive">
        <table class="styled-table table align-middle">
            <thead>
            <tr>
                <th>Date</th>
                <th>Home</th>
                <th></th>
                <th>Away</th>
                <th>Odds</th>
                <th>Odds Over/Under</th>
{#                <th>1</th>#}
{#                <th>X</th>#}
{#                <th>2</th>#}
                <th>Result</th>
                <th>Output</th>
                <th>Goals</th>
                <th>Search</th>
            </tr>
            </thead>
            <tbody>
            {% for placement in placements %}
                {{ component('Placement', {'placement' : placement, 'currentCashBox' : cashBoxValues[loop.index-1]}) }}
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
