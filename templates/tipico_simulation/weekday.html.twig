{% extends 'base.html.twig' %}

{% block title %}Weekdays{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Best simulators for {{ "now"|date("l") }}</h1>
            <p class="page-subtitle">Strategies that performed best on this weekday
                (top {{ topWeekDaySimulators|length }}).</p>
        </div>
        <a class="btn btn-primary" href="{{ path('app_tipico_weekday_suggestions') }}">
            <i class="fa-solid fa-lightbulb me-1"></i>Today's suggestions
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>Id</th>
                <th>Strategy</th>
                <th class="text-end">Cash box</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for simulator in topWeekDaySimulators %}
                <tr>
                    <td>
                        <a href="{{ path('app_tipico_simulation_detail', {simulator: simulator.id}) }}">#{{ simulator.id }}</a>
                    </td>
                    <td class="text-break">{{ simulator.identifier }}</td>
                    <td class="text-end text-nowrap {{ simulator.cashBox >= 100 ? 'value-positive' : 'value-negative' }}">{{ simulator.cashBox|number_format(2, ',', '.') }}
                        €
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary"
                           href="{{ path('app_tipico_simulation_statistic', {simulator: simulator.id}) }}">Statistic</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-body-secondary p-4">No simulators for this weekday.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
