<div{{ attributes }}>
    {% if this.initialLoad %}
        <button class="btn btn-sm btn-outline-primary text-nowrap" data-action="live#action"
                data-live-action-param="getStatistic">
            <i class="fa-solid fa-chart-simple me-1"></i>Load
        </button>
    {% else %}
        {% set statistic = this.statistic %}
        {% if statistic|length > 0 %}
            <div class="row">
                <div class="switchable-content-element active result-content">{{ component('KeyValueListing', {'container' : statistic['result']}) }}</div>
            </div>
        {% endif %}
    {% endif %}
</div>