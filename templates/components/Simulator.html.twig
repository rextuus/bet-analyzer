<tr{{ attributes }}>
    <td class="text-nowrap">
        <a href="{{ path('app_tipico_simulation_detail', {simulator: simulator.id}) }}">#{{ simulator.id }}</a>
    </td>
    <td>
        <a class="fw-semibold text-break"
           href="{{ path('app_tipico_simulation_placements', {simulator: simulator.id}) }}">{{ simulator.identifier }}</a>
        <div class="d-flex flex-wrap gap-1 mt-2">
            {% for key, value in this.parameters %}
                <span class="badge text-bg-secondary fw-normal">{{ key }}: <strong>{{ value }}</strong></span>
            {% endfor %}
        </div>
    </td>
    <td class="text-end text-nowrap fw-semibold {{ simulator.cashBox >= 100 ? 'value-positive' : 'value-negative' }}">
        {{ simulator.cashBox|number_format(2, ',', '.') }} €
    </td>
    <td style="min-width: 16rem">
        <div style="height: 6rem">{{ render_chart(this.compactCashBoxChart) }}</div>
        <a class="small" href="{{ path('app_tipico_simulation_chart_show', {simulator: simulator.id}) }}">Chart
            detail</a>
    </td>
    <td>
        <twig:SimulatorStatistic :simulator="simulator"/>
    </td>
</tr>
