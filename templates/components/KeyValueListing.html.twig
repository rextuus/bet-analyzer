<div class="key-value-listing" {{ attributes }}>
    <table class="table table-sm mb-0">
        {% set values = this.values %}
        {% for key in this.keys %}
            <tr>
                <td class="text-body-secondary">{{ key }}</td>
                <td class="text-end fw-semibold">{{ values[loop.index0] }}</td>
            </tr>
        {% endfor %}
    </table>
</div>
