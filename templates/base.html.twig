<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>{% block title %}Dashboard{% endblock %} · BetAnalyzer</title>
        <link rel="icon"
              href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚽</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('fontawesome/css/all.min.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/main.scss') }}">
        {% endblock %}

        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>
    {% set route = app.request.attributes.get('_route') ?? '' %}
    <nav class="navbar navbar-expand-lg ba-navbar sticky-top">
        <div class="container-xxl">
            <a class="navbar-brand" href="{{ path('app_tipico_simulation_dashboard') }}">
                <i class="fa-solid fa-chart-line brand-mark"></i>BetAnalyzer
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation"
                    aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="main-navigation">
                {% if app.user %}
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link {{ route == 'app_tipico_simulation_dashboard' ? 'active' }}"
                               href="{{ path('app_tipico_simulation_dashboard') }}"><i class="fa-solid fa-gauge"></i>Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ route starts with 'app_tipico_simulat' and route != 'app_tipico_simulation_dashboard' ? 'active' }}"
                               href="{{ path('app_tipico_simulator_list') }}"><i class="fa-solid fa-robot"></i>Simulators</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ route starts with 'app_favorite' ? 'active' }}"
                               href="{{ path('app_favorite_list') }}"><i class="fa-solid fa-star"></i>Favorites</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ route starts with 'app_tipico_weekday' ? 'active' }}"
                               href="{{ path('app_tipico_weekday') }}"><i class="fa-solid fa-calendar-week"></i>Weekdays</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ route starts with 'app_analysis' ? 'active' }}"
                               href="{{ path('app_analysis') }}"><i class="fa-solid fa-magnifying-glass-chart"></i>Analysis</a>
                        </li>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin') }}"><i class="fa-solid fa-sliders"></i>Admin</a>
                            </li>
                        {% endif %}
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-body-secondary small d-none d-lg-inline">{{ app.user.userIdentifier }}</span>
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_logout') }}">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>Log out
                        </a>
                    </div>
                {% else %}
                    <div class="ms-auto">
                        <a class="btn btn-sm btn-primary" href="{{ path('app_login') }}">Log in</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </nav>

    <main class="container-xxl pb-4">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} mt-3" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    <footer class="ba-footer mt-4 py-3">
        <div class="container-xxl d-flex flex-wrap justify-content-between gap-2">
            <span>BetAnalyzer · WH-Company</span>
            <span>Odds: Tipico · simulated bets only, no real money</span>
        </div>
    </footer>
    </body>
</html>
