{% extends 'base.html.twig' %}

{% block title %}{{ name }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div class="mw-100">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_favorite_list') }}">Favorites</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ name }}</li>
                </ol>
            </nav>
            <h1 class="text-break">{{ name }}</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <div class="btn-group" role="group" aria-label="Place bets">
                <a href="{{ path('app_favorite_place', {simulatorFavoriteList: favoriteList.id}) }}"
                   class="btn btn-primary"><i class="fa-solid fa-cash-register me-1"></i>Place (by simulator)</a>
                <a href="{{ path('app_favorite_place_grouped', {simulatorFavoriteList: favoriteList.id}) }}"
                   class="btn btn-outline-primary">Merged</a>
                <a href="{{ path('app_favorite_place_time_schedule', {simulatorFavoriteList: favoriteList.id}) }}"
                   class="btn btn-outline-primary">By time</a>
            </div>
            <a href="{{ path('app_favorite_remove', {simulatorFavoriteList: favoriteList.id}) }}"
               class="btn btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Remove simulators</a>
        </div>
    </div>

    <div class="favorite-detail p-0">
        <twig:FavoriteListDynamicChart :favoriteList="favoriteList"/>
    </div>
{% endblock %}
