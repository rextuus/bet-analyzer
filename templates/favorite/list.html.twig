{% extends 'base.html.twig' %}

{% block title %}Favorites{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Favorite lists</h1>
            <p class="page-subtitle">Period: {{ from|date('d.m.Y H:i') }} – {{ until|date('d.m.Y H:i') }}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <div class="btn-group" role="group" aria-label="Period">
                <a href="{{ path('app_favorite_list') }}" class="btn btn-outline-secondary">Today</a>
                <a href="{{ path('app_favorite_list', { 'from': date('-7 days')|date('U') }) }}"
                   class="btn btn-outline-secondary">7 days</a>
                <a href="{{ path('app_favorite_list', { 'from': date('-1 year').timestamp }) }}"
                   class="btn btn-outline-secondary">1 year</a>
            </div>
            <a href="{{ path('app_favorite_create') }}" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>New
                list</a>
        </div>
    </div>

    <div class="row g-3">
        {% for list in lists %}
            {% set balance = balanceToday[loop.index0] %}
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <a class="h5 mb-0 d-block text-decoration-none"
                                   href="{{ path('app_favorite_detail', {simulatorFavoriteList: list.id, from: from, until: until}) }}">{{ list.identifier }}</a>
                                <span class="small text-body-secondary">created {{ list.created|date('d.m.Y') }}</span>
                            </div>
                            <div class="text-end">
                                <div class="fs-4 fw-bold {{ balance > 0 ? 'value-positive' : (balance < 0 ? 'value-negative') }}">{{ balance|number_format(2, ',', '.') }}
                                    €
                                </div>
                                <span class="small text-body-secondary">{{ betsToday[loop.index0] }}/{{ nextPlacements[loop.index0] }} bets</span>
                            </div>
                        </div>
                        <ul class="list-unstyled mb-0 small">
                            {% for simulator in list.getSimulatorsOrderedByCashBox %}
                                <li class="d-flex justify-content-between gap-2 py-1 border-top">
                                    <a class="text-break"
                                       href="{{ path('app_tipico_simulation_detail', {simulator: simulator.id}) }}">{{ simulator.identifier }}</a>
                                    <span class="text-nowrap {{ simulator.cashBox >= 100 ? 'value-positive' : 'value-negative' }}">{{ simulator.cashBox|number_format(2, ',', '.') }} €</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12"><p class="text-body-secondary">No favorite lists yet.</p></div>
        {% endfor %}
    </div>
{% endblock %}
