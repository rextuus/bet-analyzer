# bet-analyzer – Produktionswerte für compose.prod.yaml. Vorlage ohne echte Werte, nie echte Werte hier eintragen.
#
# Ergebnis ist immer .env.prod.local im Stack-Ordner:
#  - Komodo (Standard): Werte im Stack unter „Environment“ (siehe deploy/komodo/bet-analyzer.toml). Mit [SECRET]
#    markierte Werte als Komodo-Variable mit Häkchen „Secret“ anlegen (Settings → Variables, Name hinter
#    „Komodo:“) und im Environment als Platzhalter einsetzen. Komodo schreibt .env.prod.local bei jedem Deploy
#    neu – die Datei auf dem Server also nicht von Hand ändern, sondern in Komodo.
#  - Probelauf auf dem eigenen Rechner: diese Datei kopieren, Werte ausfüllen, VOLUME_PREFIX setzen
#    (docs/deployment.md, „Probelauf“).
# .env.prod.local nie ins Repository. Die Secrets im Passwortmanager aufbewahren.

# --- Adresse ---------------------------------------------------------------------------------------------
# Öffentliche Adresse mit https://. Komodo: fest in deploy/komodo/bet-analyzer.toml.
DEFAULT_URI=https://bet-analyzer.example.de

# --- Secrets ---------------------------------------------------------------------------------------------
# [SECRET] Symfony-Schlüssel (Sitzungen, Remember-me-Cookies, CSRF). Beim Umzug den bisherigen Wert von
# securitas übernehmen (/var/www/bet-analyzer/.env bzw. .env.local), sonst sind alle abgemeldet.
# Neu: `openssl rand -hex 32`. Komodo: BET_ANALYZER_APP_SECRET
APP_SECRET=
# [SECRET] Passwort des Datenbank-Benutzers. Gilt nur beim allerersten Start (leeres Volume); danach muss es zum
# bestehenden Volume passen. Neu würfeln: `openssl rand -hex 24`. Komodo: BET_ANALYZER_MYSQL_PASSWORD
MYSQL_PASSWORD=
# [SECRET] Root-Passwort der Datenbank (auch für die Sicherungen). Wie oben. Komodo: BET_ANALYZER_MYSQL_ROOT_PASSWORD
MYSQL_ROOT_PASSWORD=
# [SECRET] Telegram-Feed, Format telegram://BOT_TOKEN@default?channel=CHAT_ID (Wert von securitas übernehmen).
# null://null = keine Nachrichten. Komodo: BET_ANALYZER_TELEGRAM_DSN
TELEGRAM_DSN=null://null
# [SECRET] Sentry-DSN für Fehlermeldungen (leer = aus). Komodo: BET_ANALYZER_SENTRY_DSN
# (ohne Sentry die Zeile im Komodo-Environment löschen statt eine leere Variable anzulegen)
SENTRY_DSN=
# [SECRET] Mailversand (kann Zugangsdaten enthalten). null://null = keine Mails; bet-analyzer verschickt derzeit
# nichts. Komodo: BET_ANALYZER_MAILER_DSN (anlegen mit dem Wert null://null)
MAILER_DSN=null://null

# [SECRET, optional] Token für die Daten-API /api/* (Header X-Api-Token). Leer = API geschlossen. Nur nötig,
# wenn wieder Betano/Bwin-Daten eingeliefert werden sollen. Dann `openssl rand -hex 32`, als
# BET_ANALYZER_API_TOKEN in Komodo anlegen und im Environment der .toml „API_TOKEN = …“ ergänzen.
API_TOKEN=

# --- Datenbank (fest, nicht ändern: gehört zum bestehenden Volume) ----------------------------------------
MYSQL_DATABASE=bet_analyzer
MYSQL_USER=bet_analyzer

# --- Fachliches (Komodo: fest in bet-analyzer.toml) -------------------------------------------------------
# 1 = Statusmeldungen (Spiele eingelesen, Simulatoren) an den Telegram-Kanal schicken.
TELEGRAM_ENABLED=0
# Untergrenze der Simulator-Kasse, ab der ein Simulator nicht mehr setzt.
CASH_BOX_MIN_LIMIT=80
# Zweitserver für den Befehl SyncBetFromBackupServer (nur von Hand). Leer lassen, solange es keinen gibt.
BACKUP_SERVER_IP=

# --- Eingang: Caddy auf dem VPS → WireGuard → hierher ------------------------------------------------------
# Der einzige Host-Port des Stacks (abyss: 8198). Komodo: fest in deploy/komodo/bet-analyzer.toml.
HTTP_PORT=8198
# Nur auf dieser Adresse lauschen – die WireGuard-IP von abyss. Lokal: 127.0.0.1.
HTTP_BIND=10.0.0.2
# Von wem X-Forwarded-For/-Proto übernommen werden: die WireGuard-IP des VPS-Caddys.
REVERSE_PROXY_IPS=10.0.0.1

# --- Sicherungen (Dienst backup, deploy/komodo/db-backup.sh) ----------------------------------------------
# Host-Ordner für die Datenbank-Dumps. Muss existieren (einmalig: sudo install -d -m 700 /srv/bet-analyzer/backups)
# – Docker legt ihn absichtlich nicht selbst an.
BACKUP_DIR=/srv/bet-analyzer/backups
# So viele Dumps je Anlass (daily, pre-deploy, manuell) bleiben liegen.
BACKUP_KEEP=7

# --- Nur für Probeläufe ----------------------------------------------------------------------------------
# Präfix der Volume-Namen (Standard bet-analyzer → bet-analyzer_database_data, …). Auf dem Server NIE setzen.
# Auf dem Entwicklungsrechner PFLICHT (z. B. betanalyzerprobe).
#VOLUME_PREFIX=betanalyzerprobe
